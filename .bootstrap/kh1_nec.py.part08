th.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=fields); writer.writeheader(); writer.writerows(rows)


def _write_json(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="utf-8")


def _sha256(path):
    digest = hashlib.sha256(); digest.update(path.read_bytes()); return digest.hexdigest()


def _manifest(directory):
    paths = sorted(path for path in directory.rglob("*") if path.is_file() and path.name != "SHA256SUMS")
    (directory / "SHA256SUMS").write_text("".join(f"{_sha256(path)}  {path.relative_to(directory).as_posix()}\n" for path in paths), encoding="utf-8")
